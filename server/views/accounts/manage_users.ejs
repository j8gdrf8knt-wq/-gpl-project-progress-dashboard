<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Manage Users — GPL Power BI Dashboard</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/main.css">
<style>
  .mu-wrap{max-width:1100px;margin:0 auto;padding:32px 24px}
  table.mu-table{width:100%;border-collapse:collapse;font-size:12px}
  table.mu-table th, table.mu-table td{padding:8px 10px;border-bottom:1px solid var(--border);text-align:left}
  table.mu-table th{color:var(--text2);font-weight:500;font-size:11px}
  .perm-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:6px 14px;margin:10px 0}
  .perm-grid label{display:flex;align-items:center;gap:6px;font-size:11.5px;color:var(--text2)}
  .badge{display:inline-block;padding:2px 8px;border-radius:999px;font-size:10px;font-weight:600}
  .badge-admin{background:rgba(0,212,136,.15);color:var(--green)}
  .badge-disabled{background:rgba(255,77,109,.15);color:var(--red)}
  details.user-row summary{cursor:pointer;list-style:none}
  details.user-row summary::-webkit-details-marker{display:none}
</style>
</head>
<body>
<div class="topbar">
  <div class="logo"><img src="/logo.png" style="height:40px"></div>
  <div class="topbar-title"><h1>Manage Users</h1><p>Approve signups &amp; control per-user permissions</p></div>
  <div class="topbar-right">
    <a class="btn btn-outline btn-sm" href="/">← Dashboard</a>
    <form method="post" action="/logout" style="display:inline">
      <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
      <button class="btn btn-outline btn-sm" type="submit">Log out</button>
    </form>
  </div>
</div>

<div class="mu-wrap">
  <div class="panel">
    <div class="panel-header"><h2>Pending approval (<%= pendingUsers.length %>)</h2></div>
    <div class="panel-body">
      <% if (!pendingUsers.length) { %>
        <p style="color:var(--text2)">No pending signups.</p>
      <% } else { %>
      <table class="mu-table">
        <tr><th>Name</th><th>Email</th><th>Requested</th><th></th></tr>
        <% pendingUsers.forEach(u => { %>
        <tr>
          <td><%= u.firstName %> <%= u.lastName %></td>
          <td><%= u.email %></td>
          <td><%= u.createdAt.toLocaleString() %></td>
          <td style="white-space:nowrap">
            <form method="post" action="/manage/users" style="display:inline">
              <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
              <input type="hidden" name="userId" value="<%= u.id %>">
              <button class="btn btn-green btn-xs" type="submit" name="action" value="approve">Approve</button>
            </form>
            <form method="post" action="/manage/users" style="display:inline">
              <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
              <input type="hidden" name="userId" value="<%= u.id %>">
              <button class="btn btn-red btn-xs" type="submit" name="action" value="reject">Reject</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </table>
      <% } %>
    </div>
  </div>

  <div class="panel" style="margin-top:20px">
    <div class="panel-header"><h2>Active users (<%= activeUsers.length %>)</h2></div>
    <div class="panel-body">
      <% activeUsers.forEach(u => { %>
      <details class="user-row" style="border-bottom:1px solid var(--border);padding:10px 0">
        <summary style="display:flex;align-items:center;gap:10px">
          <span style="flex:1"><%= u.firstName %> <%= u.lastName %> — <%= u.email || ('@' + u.username) %></span>
          <% if (u.isAdmin) { %><span class="badge badge-admin">Admin</span><% } %>
          <% if (!u.isActive) { %><span class="badge badge-disabled">Disabled</span><% } %>
        </summary>
        <div style="padding:14px 0 4px">
          <div style="display:flex;gap:8px;margin-bottom:12px">
            <% if (u.id !== currentUserId) { %>
            <form method="post" action="/manage/users">
              <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
              <input type="hidden" name="userId" value="<%= u.id %>">
              <button class="btn btn-outline btn-xs" type="submit" name="action" value="toggle_admin">
                <%= u.isAdmin ? 'Revoke admin' : 'Make admin' %>
              </button>
            </form>
            <form method="post" action="/manage/users">
              <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
              <input type="hidden" name="userId" value="<%= u.id %>">
              <button class="btn btn-outline btn-xs" type="submit" name="action" value="toggle_active">
                <%= u.isActive ? 'Disable account' : 'Re-enable account' %>
              </button>
            </form>
            <% } else { %>
            <span style="font-size:11px;color:var(--text2)">This is you</span>
            <% } %>
          </div>

          <form method="post" action="/manage/users">
            <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
            <input type="hidden" name="userId" value="<%= u.id %>">
            <div class="perm-grid">
              <% permissions.forEach(p => { %>
              <label>
                <input type="checkbox" name="permissions" value="<%= p.key %>" <%= u.permissions.includes(p.key) ? 'checked' : '' %>>
                <%= p.label %>
              </label>
              <% }) %>
            </div>
            <button class="btn btn-blue btn-xs" type="submit" name="action" value="update_permissions">Save permissions</button>
          </form>
        </div>
      </details>
      <% }) %>
    </div>
  </div>
</div>
</body>
</html>
