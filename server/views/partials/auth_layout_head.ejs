<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= title %></title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/main.css">
<style>
  .auth-shell{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px}
  .auth-card{width:100%;max-width:400px;background:var(--card);border:1px solid var(--border);border-radius:var(--radius-lg);box-shadow:var(--shadow-lg);padding:32px}
  .auth-card img{height:40px;display:block;margin:0 auto 20px}
  .auth-card h1{font-size:16px;font-weight:600;text-align:center;margin-bottom:4px}
  .auth-card p.sub{font-size:12px;color:var(--text2);text-align:center;margin-bottom:24px}
  .auth-field{margin-bottom:14px}
  .auth-field label{display:block;font-size:11px;color:var(--text2);margin-bottom:6px}
  .auth-field input{
    width:100%;background:var(--card2);border:1px solid var(--border2);color:var(--text);
    padding:10px 12px;border-radius:var(--radius-sm);font-size:13px;font-family:inherit;
  }
  .auth-field input:focus{outline:none;border-color:var(--blue)}
  .auth-errors{color:var(--red);font-size:11px;margin-top:6px}
  .auth-submit{width:100%;margin-top:6px;justify-content:center}
  .auth-footer{margin-top:18px;text-align:center;font-size:12px;color:var(--text2)}
  .auth-footer a{color:var(--blue);text-decoration:none}
  .auth-msg{padding:10px 12px;border-radius:var(--radius-sm);font-size:12px;margin-bottom:16px;border:1px solid var(--border2)}
  .auth-msg.error{border-color:rgba(255,77,109,.4);color:var(--red)}
  .auth-msg.success{border-color:rgba(0,212,136,.4);color:var(--green)}
</style>
</head>
<body>
<div class="auth-shell">
  <div class="auth-card">
    <img src="/logo.png" alt="Green Power">
